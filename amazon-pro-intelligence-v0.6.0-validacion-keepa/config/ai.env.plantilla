# ==============================================================================
#  CONFIGURACION DE LA IA (OpenAI) - Amazon Pro Intelligence
#  Este archivo vive FUERA del proyecto: no se sube a GitHub ni se incluye en ningun ZIP.
#  NO lo envies a nadie ni lo pegues en ningun chat.
# ==============================================================================

# >>> PEGA TU CLAVE AQUI, justo despues del signo =  (sin comillas, sin espacios, en una sola linea)
# >>> Debe empezar por sk-
OPENAI_API_KEY=PEGA_AQUI_TU_CLAVE

# ------------------------------------------------------------------------------
# INTERRUPTOR DE SEGURIDAD: 0 = la IA NO hace ninguna llamada (no cuesta nada)
#                           1 = la IA puede llamar a OpenAI (cuesta dinero)
# Dejalo en 0 hasta que decidas autorizar el gasto.
AMAZON_PRO_AI_ENABLE=0
# ------------------------------------------------------------------------------

# Estos valores ya estan preparados; no hace falta tocarlos.
AMAZON_PRO_AI_PROVIDER=openai
AMAZON_PRO_AI_PROFILE=economico
AMAZON_PRO_AI_MONTHLY_BUDGET=2
AMAZON_PRO_AI_MAX_COST=0.02
AMAZON_PRO_AI_MAX_OUT=2500
AMAZON_PRO_AI_TIMEOUT=40
