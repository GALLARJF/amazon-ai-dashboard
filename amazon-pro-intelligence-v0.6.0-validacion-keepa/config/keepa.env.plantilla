# ==============================================================================
#  CONFIGURACION DE KEEPA - Amazon Pro Intelligence V0.4.0
#  Este archivo vive FUERA del proyecto: no se sube a GitHub ni se incluye en ningun ZIP.
#  NO lo envies a nadie ni pegues la clave en ningun chat.
# ==============================================================================
# >>> PEGA TU CLAVE DE KEEPA justo despues del signo = (sin comillas, sin espacios)
KEEPA_API_KEY=PEGA_AQUI_TU_CLAVE_KEEPA

# INTERRUPTOR: 0 = Keepa NO se consulta nunca   1 = se puede consultar (consume tokens de tu plan)
AMAZON_PRO_KEEPA_ENABLE=0

# Presupuesto de tokens por lote: si una consulta lo supera, la app te pide aprobacion antes de gastar.
AMAZON_PRO_KEEPA_BATCH_BUDGET=30
# Tope absoluto por lote (la app nunca lo supera).
AMAZON_PRO_KEEPA_HARD_CAP=120
# Horas que se reutilizan los datos guardados (evita gastar tokens dos veces por lo mismo).
AMAZON_PRO_KEEPA_CACHE_HOURS=24
