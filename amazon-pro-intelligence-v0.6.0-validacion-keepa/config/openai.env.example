# Copia a un archivo FUERA del proyecto (p. ej. ~/.amazon_pro_ai.env), añade tu clave y haz:  set -a; source ~/.amazon_pro_ai.env; set +a
# NO guardes la clave dentro de la carpeta del proyecto ni la subas a ningún repositorio. NUNCA va en el frontend.
AMAZON_PRO_AI_PROVIDER=openai
AMAZON_PRO_AI_PROFILE=economico            # economico=gpt-6-luna | razonamiento=gpt-6.1-sol | maximo=gpt-6-astra (supera el tope por ejecución por defecto)
# AMAZON_PRO_AI_MODEL=                      # opcional: fuerza un ID concreto (si no está en la tabla de tarifas, define también PRICE_IN/OUT)
AMAZON_PRO_AI_REASONING=low                # none|low|medium|high|xhigh|max
AMAZON_PRO_AI_MAX_OUT=2500                 # tope de tokens de SALIDA (incluye razonamiento)
AMAZON_PRO_AI_MAX_IN=12000                 # tope de tokens de ENTRADA (estimados)
AMAZON_PRO_AI_MAX_COST=0.02                # USD máximo por ejecución (peor caso, calculado ANTES de llamar)
AMAZON_PRO_AI_TIMEOUT=40                   # segundos (1–120). Sin reintentos automáticos: un timeout deja el consumo como INCIERTO (se retiene el peor caso)
AMAZON_PRO_AI_MAX_CONCURRENT=1             # llamadas simultáneas (1–4); las demás quedan «SIN IA · IA_OCUPADA»
AMAZON_PRO_AI_MONTHLY_BUDGET=2             # USD/mes OBLIGATORIO; suma de ejecuciones REAL registradas
OPENAI_API_KEY=                            # ← pega aquí la clave (solo en tu equipo)
AMAZON_PRO_AI_ENABLE=0                     # cambia a 1 SOLO cuando quieras autorizar llamadas de pago
